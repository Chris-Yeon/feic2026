# Server Configuration
PORT=3000
APP_URL=http://localhost:3000

# ==============================================================================
# 1. Supabase Configuration (Backend ONLY)
# ==============================================================================
# Find these in Supabase Dashboard: Project Settings -> API
# CRITICAL SECURITY RULE:
# - SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security (RLS).
# - It must NEVER be exposed to browser frontend code or public repositories!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ==============================================================================
# 2. Paystack Configuration
# ==============================================================================
# Find these in Paystack Dashboard: Settings -> API Keys & Webhooks
# - PAYSTACK_SECRET_KEY is backend-only. It is used to initialize transactions
#   and verify HMAC-SHA512 webhook signatures.
# - PAYSTACK_PUBLIC_KEY is safe for client-side frontend code (Paystack inline popup).
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
